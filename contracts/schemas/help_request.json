{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeherd.dev/schemas/help_request.json",
  "title": "Help Request",
  "description": "Broadcast by a farm needing evacuation help. Contains a coarse area, never an exact address.",
  "type": "object",
  "required": ["request_id", "farm_id", "geohash", "species_needed", "requested_at"],
  "properties": {
    "request_id": { "type": "string" },
    "farm_id": { "type": "string" },
    "geohash": {
      "type": "string",
      "minLength": 4,
      "maxLength": 6,
      "description": "~5 km precision geohash of the farm's area."
    },
    "species_needed": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "message": { "type": "string", "maxLength": 500 },
    "requested_at": { "type": "string", "format": "date-time" },
    "schema_version": { "type": "string" }
  },
  "additionalProperties": false
}
