{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeherd.dev/schemas/facility_card.json",
  "title": "Facility Card",
  "description": "A facility that can shelter evacuated animals.",
  "type": "object",
  "required": ["id", "name", "lat", "lon", "accepts", "capacity", "county"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique slug, e.g. del_mar_fairgrounds."
    },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "accepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/species" },
      "minItems": 1,
      "uniqueItems": true
    },
    "capacity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "minProperties": 1
    },
    "infrastructure": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "access_road": { "type": "string", "default": "" },
    "trailer_access": { "type": "boolean", "default": true },
    "hours": { "type": "string", "default": "" },
    "contact": { "type": "string", "default": "" },
    "distance_from_fire_origin_km": { "type": "number", "minimum": 0 },
    "county": { "type": "string", "minLength": 1 },
    "verified": { "type": "boolean", "default": true },
    "volunteer_run": { "type": "boolean", "default": false },
    "has_own_feed": { "type": "boolean", "default": false },
    "notes": { "type": "string", "default": "" },
    "source": { "type": "string", "default": "" }
  },
  "additionalProperties": false,
  "$defs": {
    "species": {
      "type": "string",
      "enum": [
        "horses", "miniature_horses", "mules", "donkeys",
        "cattle", "cattle_calves", "goats", "sheep", "pigs", "poultry"
      ]
    }
  }
}
